<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#3A2226" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#4A2A30" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#3A2226" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
